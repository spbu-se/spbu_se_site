root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 4
max_line_length = 100
trim_trailing_whitespace = false

[*.{json,toml}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
