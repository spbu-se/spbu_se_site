{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "schedule": ["before 9am on monday"],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchManagers": ["pep621", "uv"],
      "groupName": "Python dev dependencies",
      "matchDepTypes": ["dev"],
      "automerge": true
    },
    {
      "matchManagers": ["pep621", "uv"],
      "matchDepTypes": ["dev"],
      "labels": ["dependencies", "dev"]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  }
}
