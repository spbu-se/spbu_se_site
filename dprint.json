{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "indentWidth": 2,
  "yaml": {
    "printWidth": 100
  },
  "toml": {
    "lineWidth": 100,
    "indentWidth": 4
  },
  "json": {},
  "includes": [
    "**/*.{yaml,yml,toml,json}"
  ],
  "excludes": [
    ".venv/**",
    ".git/**",
    ".mypy_cache/**",
    ".pytest_cache/**",
    ".ruff_cache/**",
    "**/__pycache__/**",
    ".opencode/package-lock.json",
    "**/node_modules/**",
    "template-project/**",
    "src/static/assets/libs/**",
    ".gitleaks.toml"
  ],
  "plugins": [
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/json-0.22.0.wasm"
  ]
}
